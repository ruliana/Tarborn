// Instrument patches for the music, as tarborn_sfx sounds plus how they
// follow notes. These three are seed patches so step 1 can render; step 3
// replaces them with patches generated and scored against per-role sound
// descriptors.
//
// Per patch (fields left out take the default):
//   sound: a tarborn_sfx sound, as in assets/sfx.ron
//   pitched true        notes retune the sound
//   root 69             MIDI pitch the sound is written at
//   filter_tracking 1   0 fixed cutoffs, 1 cutoffs follow pitch
//   gate false          hold for the note's length instead of ringing out
//   gain 1              level in the mix
(
    patches: {
        "bass": (
            root: 36.0,
            filter_tracking: 0.5,
            gain: 0.9,
            sound: (
                layers: [
                    // Finger pluck: a short click of noise.
                    (wave: Noise, freq: 3000.0, decay: 0.015, decay_curve: 2.0, gain: 0.25, lowpass: 2500.0),
                    // Body: rounded triangle that dulls as it rings.
                    (wave: Triangle, freq: 65.41, attack: 0.004, decay: 0.7, decay_curve: 2.2,
                     lowpass: 900.0, lowpass_end: 250.0, drive: 0.4),
                ],
            ),
        ),
        "ride": (
            pitched: false,
            gain: 0.35,
            sound: (
                layers: [
                    // Stick ping.
                    (wave: Square, freq: 1180.0, duty: 0.3, decay: 0.05, decay_curve: 2.0, gain: 0.3,
                     highpass: 2000.0),
                    // Wash: bright noise with a long, falling tail.
                    (wave: Noise, freq: 16000.0, decay: 0.9, decay_curve: 3.0, highpass: 5000.0,
                     lowpass: 12000.0, resonance: 0.3, seed: 7),
                ],
            ),
        ),
        "piano": (
            root: 60.0,
            filter_tracking: 0.7,
            gain: 0.45,
            sound: (
                layers: [
                    (wave: Square, freq: 261.63, duty: 0.2, decay: 1.2, decay_curve: 2.5,
                     lowpass: 3000.0, lowpass_end: 600.0),
                    (wave: Sine, freq: 523.25, decay: 0.6, decay_curve: 2.0, gain: 0.4),
                ],
            ),
        ),
    },
)
