// Tarborn's music tuning. Every number that shapes the music lives here or
// in assets/music/; nothing is tuned in code.
//
// To render a fragment to a WAV file outside the game:
//   cargo run -p tarborn_music --bin render -- <fragment.ron> out.wav [seed]
// (patches come from assets/music/patches.ron; pass --patches to override).
(
    // How fragments are rendered offline: previews, tests and the library.
    // The live director (step 8) takes tempo and swing from the stage style.
    render: (
        sample_rate: 44100,
        bpm: 120.0,
        // Share of each beat taken by its first eighth; 0.5 is straight.
        swing: 0.62,
        // Tuning reference, Hz.
        a4: 440.0,
        master_volume: 0.6,
        // Note gain = velocity ^ velocity_curve.
        velocity_curve: 1.6,
        // Humanisation, driven by the render seed: most a note moves early
        // or late (beats) and how much its velocity moves (fraction).
        timing_jitter: 0.01,
        velocity_jitter: 0.08,
        // Seconds rendered past the end so the last notes ring out.
        tail: 0.6,
        limit: true,
    ),

    // The live stream in game, kept in step with the sim's beat clock.
    stream: (
        // Seconds ahead of the sim that notes are scheduled.
        lookahead: 0.1,
        // Share of the measured drift between sim and audio device closed
        // each frame (0 never follows, 1 jumps).
        smoothing: 0.05,
        // Seconds of jump (pause, hitch, new room) that re-anchors at once.
        resync_threshold: 0.1,
        // Seconds scheduled notes play early to make up for output latency,
        // on top of the measured device buffer when auto_compensate is on.
        latency_compensation: 0.0,
        auto_compensate: true,
        // Seconds between two sample requests that ends a device burst
        // (how the buffer is measured), and buffers assumed in flight.
        burst_gap: 0.0005,
        buffers_in_flight: 2.0,
        // Seconds between "music output" latency lines in the console.
        log_interval: 10.0,
        max_voices: 48,
        volume: 0.8,
        // Seconds between checks of this file for edits.
        reload_interval: 0.5,
    ),

    // A debug metronome on the sim's beat clock: turn it on to hear that the
    // stream keeps time with the game. The tempo drives the beat clock until
    // the director sets it per stage.
    click: (
        enabled: false,
        bpm: 120.0,
        beats_per_bar: 4,
        volume: 0.5,
        downbeat: (layers: [(wave: Sine, freq: 1760.0, decay: 0.05, decay_curve: 2.0)]),
        beat: (layers: [(wave: Sine, freq: 880.0, decay: 0.04, decay_curve: 2.0, gain: 0.7)]),
    ),

    // Quality metrics (tarborn_music::metrics): how each measure is computed
    // and how much it weighs. Per-style targets live in the style files.
    // Statistics: cargo run --release -p tarborn_music --bin report
    metrics: (
        // Roughness of each interval class from unison to major seventh.
        dissonance: (0.0, 1.0, 0.45, 0.15, 0.1, 0.05, 0.6, 0.0, 0.1, 0.1, 0.35, 0.8),
        // Spiral array: rise per fifth (Chew's sqrt(2/15)); radius is 1.
        spiral_rise: 0.365,
        // Beats per tension window, and the mix of cloud diameter, tensile
        // strain and momentum.
        window: 1.0,
        tension_mix: (1.0, 1.0, 0.5),
        // Notes per n-gram when measuring repetition.
        ngram: 3,
        // Range widths outside a target at which a measure scores 0.
        softness: 1.0,
        weights: (
            tension: 1.0,
            dissonance: 1.0,
            voice_leading: 1.0,
            syncopation: 0.5,
            repetition: 1.0,
            density: 1.0,
        ),
    ),

    // The offline search that fills assets/music/library/ (MAP-Elites over
    // the grammar's proposals). Regenerate with:
    //   cargo run --release -p tarborn_music --bin compose
    search: (
        seed: 1,
        // Tunes proposed per style; each tempo bin x form keeps its best.
        tune_candidates: 120,
        tempo_bins: 3,
        // Proposals per part when judging a tune, and when filling a kept one.
        quick_candidates: 4,
        part_candidates: 24,
        // Part archive: density (onsets per beat) x syncopation (LHL per bar).
        density_bins: 4,
        density_range: (0.0, 2.0),
        syncopation_bins: 3,
        syncopation_range: (0.0, 3.0),
        // Most variants kept per part, from different cells.
        variants: 3,
        // Least score a proposal needs to enter.
        min_score: 0.8,
    ),

    // The live director: what the band plays, bar by bar.
    director: (
        // Played until stages pick their own style (step 9).
        style: "industrial",
        // Intensity (0..1) at which each layer above the calmest starts.
        layer_at: [0.3, 0.7],
        // Bars of lower intensity before the band drops one layer.
        fall_bars: 4,
        // Times through the form before the next tune (least, most).
        choruses: (2, 3),
        // Inside a section, one part changes variant every this many bars.
        variety_bars: 4,
        // After this many calm bars, lift one layer for breather_bars.
        breather_after: 16,
        breather_bars: 4,
        // Best variant's weight against the next best, and so on down.
        variant_bias: 2.0,
        // Band drummer velocity drop when the player drums the most.
        duck_depth: 0.6,
        // The band's answer to a burst of player hits: fill_notes even hits
        // over the bar's last fill_beats beats, rising in velocity.
        fill_beats: 1.0,
        fill_notes: 3,
        fill_velocity: (0.5, 0.9),
    ),

    // How tense the moment is: the director's intensity, from the game.
    mood: (
        // Weight of each state of an on-screen enemy; unaware weighs 0.
        states: {
            "searching": 0.35,
            "surprised": 0.5,
            "fleeing": 0.5,
            "chasing": 0.6,
            "defending": 0.6,
            "dizzy": 0.8,
            "prone": 0.8,
            "dodging": 0.8,
            "recover": 0.85,
            "windup": 0.9,
            "strike": 1.0,
        },
        // Added per engaged enemy past the first, up to crowd_max.
        crowd: 0.1,
        crowd_max: 0.3,
        // Intensity kept while a combo runs.
        combo_floor: 0.75,
        // Danger: health_weight * (1 - health) + windup_weight per windup.
        health_weight: 0.6,
        windup_weight: 0.3,
        // Share of the danger added to the intensity.
        danger_mix: 0.3,
        // Seconds to rise, and to fall (falls are slow so a fight's end
        // lingers; the director also waits fall_bars before dropping).
        rise: 0.3,
        fall: 4.0,
    ),

    // How tense the moment is: the director's intensity, from the game.
    mood: (
        // Weight of each state of an on-screen enemy; unaware weighs 0.
        states: {
            "searching": 0.35,
            "surprised": 0.5,
            "fleeing": 0.5,
            "chasing": 0.6,
            "defending": 0.6,
            "dizzy": 0.8,
            "prone": 0.8,
            "dodging": 0.8,
            "recover": 0.85,
            "windup": 0.9,
            "strike": 1.0,
        },
        // Added per engaged enemy past the first, up to crowd_max.
        crowd: 0.1,
        crowd_max: 0.3,
        // Intensity kept while a combo runs.
        combo_floor: 0.75,
        // Danger: health_weight * (1 - health) + windup_weight per windup.
        health_weight: 0.6,
        windup_weight: 0.3,
        // Share of the danger added to the intensity.
        danger_mix: 0.3,
        // Seconds to rise, and to fall (falls are slow so a fight's end
        // lingers; the director also waits fall_bars before dropping).
        rise: 0.3,
        fall: 4.0,
    ),
)
