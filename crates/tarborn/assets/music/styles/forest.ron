// Forest stage: modal jazz with brushes. Read by the music grammar
// (tarborn_music::style); every value is a starting point for the search.
// Per-layer lists are indexed by intensity layer, 0 the calmest; a short
// list repeats its last entry.
(
    name: "forest",
    tempo: (110.0, 150.0),
    beats_per_bar: 4,
    // Loose: 0.67 at 110 BPM easing to 0.62 at 150.
    swing: (slow_bpm: 110.0, slow_ratio: 0.67, fast_bpm: 150.0, fast_ratio: 0.62),
    layers: 3,
    keys: ["D", "E", "A", "G", "C", "F"],
    harmony: Modal((
        modes: [(Dorian, 3.0), (Aeolian, 2.0), (Lydian, 1.0)],
        // Short vamps so the music moves on quickly.
        vamp_bars: [8],
        // The bridge shifts the mode up a half step (So What).
        bridge_bars: [4, 8],
        bridge_shift: 1,
    )),
    bass: (
        patch: "bass",
        range: (28, 55),
        // Calm: a pedal tone; then two-feel; walking when intense.
        feel: [Pedal, TwoFeel, Walking],
        chromatic_approach: 0.3,
        ghost: 0.05,
        max_leap: 9,
        accent: 0.85,
        velocity: 0.7,
        ghost_velocity: 0.3,
    ),
    comp: (
        patches: [[], ["epiano"], ["epiano", "marimba"]],
        voicings: [Quartal, OpenFifths],
        smooth: 0.7,
        rules: (range: (50, 79), low_limit: 52, low_interval: 5),
        hits: [(0, 0), (0, 1), (1, 2)],
        offbeat_weight: 1.5,
        length: (0.5, 2.0),
        velocity: (0.4, 0.65),
    ),
    drums: (
        ride: "ride",
        hat: "hat",
        brushes: "brushes",
        ride_skip: [0.3, 0.5, 0.7],
        hat_on: [false, false, true],
        brush: [0.8, 0.9, 1.0],
        ride_velocity: (0.35, 0.5),
        hat_velocity: 0.45,
        brush_velocity: (0.35, 0.55),
    ),
    lead: (
        patch: "marimba",
        range: (60, 84),
        density: [0.0, 0.0, 0.5],
        motif_beats: [2, 4],
        fill: 0.5,
        chromatic: 0.1,
        max_leap: 7,
        velocity: (0.5, 0.75),
    ),
    stinger: (bars: 2, patches: ["epiano", "marimba"]),
    // The player's own kit: moves play these hits at once, unquantized.
    // tune: Root sounds the tonic, ChordTone walks up the chord's tones.
    // dynamics: how much a weak move (low launch power, slow slam) softens it.
    kit: (
        hits: {
            "jump": (patch: "for_kick", velocity: 0.7, tune: Root),
            "launch": (patch: "for_kick", velocity: 1.0, dynamics: 0.5, tune: Root),
            "slam": (patch: "for_kick", velocity: 1.0, dynamics: 0.4, tune: Root),
            "lunge": (patch: "for_rim", velocity: 0.7),
            "hit": (patch: "for_rim", velocity: 0.95),
            "throw": (patch: "for_rim", velocity: 0.85, dynamics: 0.5),
            "bounce": (patch: "for_accent", velocity: 0.45, tune: ChordTone),
            "pogo": (patch: "for_accent", velocity: 0.8, tune: ChordTone),
            "grab": (patch: "for_accent", velocity: 0.6, tune: ChordTone),
            "dodge": (patch: "for_accent", velocity: 0.55, tune: ChordTone),
            "kill": (patch: "for_crash", velocity: 0.9),
        },
        register: 69,
        // The band drummer fully ducks at duck_hits hits in duck_window s.
        duck_window: 2.0,
        duck_hits: 6.0,
        // burst_hits hits within burst_window s: the band answers with a
        // fill, at most once per fill_cooldown s.
        burst_hits: 4,
        burst_window: 1.0,
        fill_cooldown: 4.0,
        // A slam this close to a bar line (beats) moves to the next section.
        downbeat_window: 0.25,
        section_move: "slam",
        full_speed: 24.0,
    ),
    // Where the metrics want each part (tarborn_music::metrics), per layer.
    // Ranges come from the grammar's own spread (see the report binary),
    // tightened toward what sounds right; a measure left out isn't scored.
    targets: (
        bass: (
            tension: [(1.0, 2.0), (1.3, 2.4), (2.0, 3.2)],
            repetition: [(0.9, 1.0), (0.8, 1.0), (0.3, 0.8)],
            density: [(0.2, 0.3), (0.45, 0.55), (0.95, 1.2)],
        ),
        comp: (
            tension: [(2.3, 4.0)],
            dissonance: [(0.08, 0.2)],
            voice_leading: [(0.0, 4.0)],
            syncopation: [(0.0, 0.0), (0.0, 1.0), (0.5, 1.6)],
            density: [(0.0, 0.0), (0.1, 0.3), (0.25, 0.5)],
        ),
        drums: (
            repetition: [(0.85, 0.97)],
            density: [(1.0, 1.25)],
        ),
        lead: (
            tension: [(1.0, 3.0)],
            syncopation: [(0.2, 1.8)],
            repetition: [(0.2, 0.6)],
            density: [(0.3, 1.0)],
        ),
    ),
)
