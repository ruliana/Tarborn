// Tarborn's music tuning. Every number that shapes the music lives here or
// in assets/music/; nothing is tuned in code.
//
// To render a fragment to a WAV file outside the game:
//   cargo run -p tarborn_music --bin render -- <fragment.ron> out.wav [seed]
// (patches come from assets/music/patches.ron; pass --patches to override).
(
    // How fragments are rendered offline: previews, tests and the library.
    // The live director (step 8) takes tempo and swing from the stage style.
    render: (
        sample_rate: 44100,
        bpm: 120.0,
        // Share of each beat taken by its first eighth; 0.5 is straight.
        swing: 0.62,
        // Tuning reference, Hz.
        a4: 440.0,
        master_volume: 0.6,
        // Note gain = velocity ^ velocity_curve.
        velocity_curve: 1.6,
        // Humanisation, driven by the render seed: most a note moves early
        // or late (beats) and how much its velocity moves (fraction).
        timing_jitter: 0.01,
        velocity_jitter: 0.08,
        // Seconds rendered past the end so the last notes ring out.
        tail: 0.6,
        limit: true,
    ),

    // The live stream in game, kept in step with the sim's beat clock.
    stream: (
        // Seconds ahead of the sim that notes are scheduled.
        lookahead: 0.1,
        // Share of the measured drift between sim and audio device closed
        // each frame (0 never follows, 1 jumps).
        smoothing: 0.05,
        // Seconds of jump (pause, hitch, new room) that re-anchors at once.
        resync_threshold: 0.1,
        // Seconds scheduled notes play early to make up for output latency,
        // on top of the measured device buffer when auto_compensate is on.
        latency_compensation: 0.0,
        auto_compensate: true,
        // Seconds between two sample requests that ends a device burst
        // (how the buffer is measured), and buffers assumed in flight.
        burst_gap: 0.0005,
        buffers_in_flight: 2.0,
        // Seconds between "music output" latency lines in the console.
        log_interval: 10.0,
        max_voices: 48,
        volume: 0.8,
        // Seconds between checks of this file for edits.
        reload_interval: 0.5,
    ),

    // A debug metronome on the sim's beat clock: turn it on to hear that the
    // stream keeps time with the game. The tempo drives the beat clock until
    // the director sets it per stage.
    click: (
        enabled: false,
        bpm: 120.0,
        beats_per_bar: 4,
        volume: 0.5,
        downbeat: (layers: [(wave: Sine, freq: 1760.0, decay: 0.05, decay_curve: 2.0)]),
        beat: (layers: [(wave: Sine, freq: 880.0, decay: 0.04, decay_curve: 2.0, gain: 0.7)]),
    ),

    // Quality metrics (tarborn_music::metrics): how each measure is computed
    // and how much it weighs. Per-style targets live in the style files.
    // Statistics: cargo run --release -p tarborn_music --bin report
    metrics: (
        // Roughness of each interval class from unison to major seventh.
        dissonance: (0.0, 1.0, 0.45, 0.15, 0.1, 0.05, 0.6, 0.0, 0.1, 0.1, 0.35, 0.8),
        // Spiral array: rise per fifth (Chew's sqrt(2/15)); radius is 1.
        spiral_rise: 0.365,
        // Beats per tension window, and the mix of cloud diameter, tensile
        // strain and momentum.
        window: 1.0,
        tension_mix: (1.0, 1.0, 0.5),
        // Notes per n-gram when measuring repetition.
        ngram: 3,
        // Range widths outside a target at which a measure scores 0.
        softness: 1.0,
        weights: (
            tension: 1.0,
            dissonance: 1.0,
            voice_leading: 1.0,
            syncopation: 0.5,
            repetition: 1.0,
            density: 1.0,
        ),
    ),
)
