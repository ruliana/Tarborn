// Tarborn look tuning. Every visual number lives here.
// Edit while the game runs (cargo run): the file is re-read about twice a second.
// Colors are sRGB, 0..1. Distances are world pixels (48 px = 1 m).
(
    level: (
        hazard: (0.82, 0.27, 0.18),
        spike_width: 14.4,
        spike_height: 9.6,
    ),

    // Generated level dressing. The pieces and colors are per stage, in
    // assets/dressing/*.ron (B cycles sets); these numbers say how the level
    // shape is read.
    dressing: (
        default_set: "industrial",
        seed: 7,
        shape: (
            // Raster cell size.
            cell: 2.0,
            // Smoothing passes over the traced outline (takes out raster stairs).
            smoothing: 3,
            // Outward normal y at or above this is a floor; below, a slope.
            floor_min_up: 0.97,
            // Normal |y| below this is a wall.
            wall_max_y: 0.7,
            // Turning (radians per px, averaged over arc_window px) that makes an arc.
            arc_curvature: 0.004,
            arc_window: 60.0,
            // Turning over corner_window px that makes a corner (radians).
            corner_turn: 0.6,
            corner_window: 12.0,
            // Strips stop this far short of a corner.
            corner_gap: 8.0,
            // Probe circle radius telling outer corners from inner ones.
            corner_probe: 12.0,
            // Shorter runs are left bare.
            min_run: 10.0,
        ),
        depth_max: 128.0,
        // Past the level's bounds everything is solid, this far out.
        surround: 4000.0,
    ),

    tar: (
        body: (0.07, 0.055, 0.05),
        highlight: (1.0, 0.97, 0.92),
        // Grows the sim outline outwards so the body covers its point markers.
        round: 4.0,
        // How far in from the edge the surface reaches full height (gloss falloff).
        bevel: 10.0,
        // Edge softening, in pixels.
        aa: 1.0,
        // Light direction (x, y, toward viewer) and specular sharpness.
        light: (-0.45, 0.6, 0.65),
        spec_power: 24.0,
        spec_strength: 0.9,
        // Colored rim that shows the blob's state (sticky, charging, hurt...).
        rim_strength: 0.9,
        rim_power: 2.5,
        // How much the state color also tints the body.
        tint_body: 0.12,
        // Tar drops that heal.
        pickup_radius: 9.6,
    ),

    enemy: (
        fill: (0.94, 0.90, 0.83),
        // Recovering, dizzy or prone: open to attack.
        open: (0.70, 0.66, 0.60),
        // Winding up or striking.
        danger: (0.82, 0.27, 0.18),
        // Just hit.
        flash: (1.0, 1.0, 1.0),
        // Tar coating on an enemy that is held or thrown.
        coat: (0.07, 0.055, 0.05),
        coat_width: 5.0,
        // Outlines and marks keep their hue but are darkened to at most this
        // Oklab lightness, so they read on the pale background.
        ink_max_lightness: 0.42,
        spit_radius_scale: 1.0,
    ),

    // Eyes and body language. Each state has one mood shared by every enemy
    // kind; each kind has its own eyes. Sizes in eye sets are fractions of
    // the body radius. Mood fields: open (lids, 0 shut..1 open), scale (eye
    // size), pupil (pupil size), slant (lid tilt, radians, + = frown), stretch
    // (body height), lean (toward facing), wobble/wobble_hz (sway), bob/bob_hz
    // (breathing).
    face: (
        // How fast faces and bodies blend into a new state (per second).
        blend: 14.0,
        blink_every: 3.5,
        blink_time: 0.14,
        // Enemy eyes: dark socket, pale pupil, red pupil when attacking.
        socket: (0.12, 0.09, 0.09),
        glint: (0.97, 0.94, 0.88),
        danger: (0.85, 0.25, 0.18),
        // Body outline in the kind's color, px.
        outline_width: 2.5,
        // Searching pupils sweep side to side; dizzy pupils spin.
        sweep_hz: 0.7,
        spin_hz: 1.5,
        // Prone: X eyes, stroke width as a fraction of the eye width.
        x_width: 0.25,
        // Surprised: a ring bursting out from the body (seconds, radii, px).
        ping_time: 0.35,
        ping_radius: 1.2,
        ping_width: 3.0,
        // Dizzy: dots circling over the head.
        dizzy_dots: 3,
        dizzy_dot_radius: 2.5,
        dizzy_hz: 1.0,
        moods: (
            unaware:   (open: 0.6,  scale: 1.0,  pupil: 1.0,  slant: -0.1,  stretch: 1.0,  lean: 0.0,   wobble: 0.03, wobble_hz: 0.4, bob: 0.03, bob_hz: 0.5),
            surprised: (open: 1.0,  scale: 1.45, pupil: 0.55, slant: 0.0,   stretch: 1.3,  lean: -0.15, wobble: 0.0,  wobble_hz: 0.0, bob: 0.0,  bob_hz: 0.0),
            searching: (open: 0.85, scale: 1.05, pupil: 1.0,  slant: -0.15, stretch: 1.05, lean: 0.05,  wobble: 0.02, wobble_hz: 0.6, bob: 0.02, bob_hz: 1.0),
            chasing:   (open: 0.75, scale: 1.0,  pupil: 0.9,  slant: 0.35,  stretch: 0.95, lean: 0.25,  wobble: 0.0,  wobble_hz: 0.0, bob: 0.04, bob_hz: 3.0),
            defending: (open: 0.55, scale: 0.95, pupil: 0.9,  slant: 0.45,  stretch: 0.9,  lean: 0.1,   wobble: 0.0,  wobble_hz: 0.0, bob: 0.02, bob_hz: 1.5),
            windup:    (open: 0.45, scale: 1.1,  pupil: 1.1,  slant: 0.6,   stretch: 0.8,  lean: -0.15, wobble: 0.0,  wobble_hz: 0.0, bob: 0.0,  bob_hz: 0.0),
            strike:    (open: 1.0,  scale: 1.2,  pupil: 0.8,  slant: 0.5,   stretch: 1.2,  lean: 0.35,  wobble: 0.0,  wobble_hz: 0.0, bob: 0.0,  bob_hz: 0.0),
            recover:   (open: 0.6,  scale: 0.95, pupil: 1.0,  slant: 0.0,   stretch: 0.92, lean: 0.0,   wobble: 0.03, wobble_hz: 1.0, bob: 0.0,  bob_hz: 0.0),
            dizzy:     (open: 0.8,  scale: 1.0,  pupil: 0.7,  slant: -0.2,  stretch: 1.0,  lean: 0.0,   wobble: 0.22, wobble_hz: 1.2, bob: 0.05, bob_hz: 2.0),
            prone:     (open: 1.0,  scale: 1.0,  pupil: 1.0,  slant: 0.0,   stretch: 1.0,  lean: 0.0,   wobble: 0.0,  wobble_hz: 0.0, bob: 0.0,  bob_hz: 0.0),
            fleeing:   (open: 1.0,  scale: 1.25, pupil: 0.6,  slant: -0.3,  stretch: 1.05, lean: 0.3,   wobble: 0.08, wobble_hz: 5.0, bob: 0.05, bob_hz: 6.0),
            dodging:   (open: 0.9,  scale: 1.1,  pupil: 0.7,  slant: -0.1,  stretch: 1.25, lean: -0.2,  wobble: 0.0,  wobble_hz: 0.0, bob: 0.0,  bob_hz: 0.0),
        ),
        // The tar blob: large, tall, hollow pale eyes (pupil 0) with a dark
        // border, sloshing in the goo.
        blob: (
            eyes: (count: 2, layout: Row, size: (0.36, 0.62), spacing: 0.5, offset: (0.2, 0.18), pupil: 0.0, stalk: 0.0, brow: 0.0),
            white: (0.97, 0.94, 0.88),
            pupil: (0.07, 0.055, 0.05),
            idle:   (open: 1.0, scale: 1.0,  pupil: 1.0, slant: 0.0,  stretch: 1.0, lean: 0.0, wobble: 0.0, wobble_hz: 0.0, bob: 0.0, bob_hz: 0.0),
            shrunk: (open: 0.4, scale: 0.9,  pupil: 1.1, slant: 0.35, stretch: 1.0, lean: 0.0, wobble: 0.0, wobble_hz: 0.0, bob: 0.0, bob_hz: 0.0),
            hurt:   (open: 0.1, scale: 0.9,  pupil: 1.0, slant: -0.3, stretch: 1.0, lean: 0.0, wobble: 0.0, wobble_hz: 0.0, bob: 0.0, bob_hz: 0.0),
            wide:   (open: 1.0, scale: 1.35, pupil: 0.6, slant: 0.0,  stretch: 1.0, lean: 0.0, wobble: 0.0, wobble_hz: 0.0, bob: 0.0, bob_hz: 0.0),
            // Seconds of wide eyes after a pogo, a lunge hit or a bounce.
            wide_time: 0.35,
            slosh_stiffness: 220.0,
            slosh_damping: 9.0,
            slosh_max: 0.25,
            // Hollow eyes show where they look by shifting that way.
            gaze_shift: 0.12,
            border: 2.0,
            border_color: (0.02, 0.015, 0.015),
            // Glances at the nearest enemy this close (metres).
            glance_range: 5.0,
        ),
        dummy:   (count: 0, layout: Row, size: (0.0, 0.0), spacing: 0.0, offset: (0.0, 0.0), pupil: 0.0, stalk: 0.0, brow: 0.0),
        // One big wet eye on a stalk.
        grub:    (count: 1, layout: Cluster, size: (0.6, 0.6), spacing: 0.0, offset: (0.2, 0.3), pupil: 0.55, stalk: 0.7, brow: 0.0),
        // A visor slit with a pupil sliding along it.
        guard:   (count: 1, layout: Row, size: (1.0, 0.22), spacing: 0.0, offset: (0.25, 0.45), pupil: 0.9, stalk: 0.0, brow: 0.0),
        // Three small eyes in a cluster.
        spitter: (count: 3, layout: Cluster, size: (0.36, 0.36), spacing: 0.34, offset: (0.15, 0.15), pupil: 0.55, stalk: 0.0, brow: 0.0),
        // A row of pinprick eyes.
        skitter: (count: 4, layout: Row, size: (0.26, 0.26), spacing: 0.27, offset: (0.3, 0.1), pupil: 0.7, stalk: 0.0, brow: 0.0),
        // Two tiny eyes under a heavy brow.
        brute:   (count: 2, layout: Row, size: (0.16, 0.16), spacing: 0.42, offset: (0.25, 0.3), pupil: 0.7, stalk: 0.0, brow: 0.14),
        // The dark room (T cycles rooms): everything but the eyes is hidden.
        dark: (
            alpha: 0.995,
            color: (0.02, 0.02, 0.03),
            // Halo around each eye: radius in multiples of the eye's smaller side, opacity.
            glow_radius: 2.2,
            glow_alpha: 0.35,
        ),
    ),

    // Tar splats left by hits, on the enemy hit and the nearest surface.
    stains: (
        color: (0.07, 0.055, 0.05),
        shine: (1.0, 0.97, 0.92),
        shine_mix: 0.55,
        // On enemies (fractions of the enemy radius): base size, extra per
        // point of damage, cap; how far from the centre; how many per enemy.
        enemy_size: 0.16,
        enemy_per_damage: 0.006,
        enemy_max_size: 0.3,
        enemy_reach: 0.45,
        enemy_max: 8,
        droplets: 3,
        droplet_size: 0.3,
        // On walls and floors within wall_reach metres of a hit (sizes in px).
        wall_reach: 1.5,
        wall_size: 14.0,
        wall_per_damage: 0.4,
        wall_max_size: 34.0,
        wall_flat: 0.35,
        wall_max: 60,
        // Seconds fully dark, then seconds fading out.
        wall_hold: 6.0,
        wall_fade: 4.0,
        // Splats thrown around when an enemy dies, and a slam's floor splat.
        kill_burst: 4,
        slam_size: 40.0,
    ),

    post: (
        grain: 0.05,
        grain_fps: 24.0,
        vignette: 0.45,
        // Distance from center (0) to corner (1) where darkening starts and ends.
        vignette_start: 0.45,
        vignette_end: 1.15,
        // Dither look (V cycles looks): screen pixels per dither pixel.
        dither_pixel: 3.0,
        dither_spread: 0.8,
        // Darkest to lightest.
        palette: ((0.07, 0.055, 0.09), (0.27, 0.20, 0.31), (0.61, 0.48, 0.53), (0.93, 0.86, 0.77)),
        // Pixels this red are kept as the danger color instead of dithered.
        danger: (0.88, 0.33, 0.24),
        red_keep: 0.35,
    ),
)
